# Server-side only. General BSC reads for /api/rpc; comma-separated (primary, then failover).
BSC_RPC_URL=
# Archive/log-capable BSC endpoints for indexing: historical eth_getCode and eth_getLogs are required.
# Missing or empty HISTORY_RPC_URL falls back to BSC_RPC_URL for compatibility.
HISTORY_RPC_URL=
# Optional seller-only platform fee. Leave BOTH blank until the user deploys and verifies the router.
# These public values are compiled into the frontend; changing them requires a fresh production build.
NEXT_PUBLIC_PLATFORM_FEE_ROUTER=
NEXT_PUBLIC_PLATFORM_FEE_START_BLOCK=
